*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.env

# Unit test / coverage reports
.coverage
.coverage.*
.cache
.pytest_cache/

# Node / Frontend dependencies and build
node_modules/
